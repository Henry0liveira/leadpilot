# Copie para .env, sem enviar esse arquivo para o Git
PORT=3000
HOST=127.0.0.1
GOOGLE_PLACES_API_KEY=
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Segredo longo e aleatório usado na URL do webhook.
EVOLUTION_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Groq Cloud: gere uma NOVA chave em https://console.groq.com/keys
# Nunca envie a chave em chats, imagens ou repositórios.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Nome e informações reais do seu serviço, para o bot não inventar promessas ou preços.
BUSINESS_NAME=Meu estúdio de desenvolvimento web
BUSINESS_OFFER=Criação de sites profissionais, cardápios digitais e integrações de atendimento
